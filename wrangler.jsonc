// Cloudflare Workers config.
// Static files in public/ are served directly; the Worker (worker/index.js) only runs for /api/*.
// Bookings are stored in a SQLite-backed Durable Object, which Cloudflare creates on the first deploy.
// Secrets (dashboard password, email keys) are set in the Cloudflare dashboard: see worker/app.js.
{
  "name": "testingg",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Keep variables added in the Cloudflare dashboard when deploying from GitHub.
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "BookingStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BookingStore"] }],
  "ratelimits": [
    // At most 5 booking attempts per visitor (IP address) per minute.
    { "name": "BOOKING_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    // At most 5 dashboard login attempts per IP address per minute.
    { "name": "LOGIN_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    // At most 60 open-times lookups per IP address per minute (normal use is a handful).
    { "name": "API_LIMITER", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
  ],
  // Keep the old testingg.cloudgroup.workers.dev address working too (older QR codes and links).
  "workers_dev": true,
  // The site's own address. Cloudflare adds the DNS record and certificate automatically.
  "routes": [
    { "pattern": "sharmagroup.dev", "custom_domain": true },
    { "pattern": "www.sharmagroup.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
