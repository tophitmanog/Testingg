// Cloudflare Workers config.
// Static files in public/ are served directly; the Worker script (worker/index.js) only runs for /api/*,
// where it handles booking requests. Secrets are set in the dashboard: see worker/index.js.
{
  "name": "testingg",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // At most 5 booking requests per visitor (IP address) per minute.
  "ratelimits": [
    { "name": "BOOKING_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
